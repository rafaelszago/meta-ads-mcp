# Meta Marketing API credentials.
# Generate via business.facebook.com → Settings → Users → System Users → Generate Token.
# Required permissions: ads_management, ads_read, business_management, read_insights.

META_ACCESS_TOKEN=EAAxxx_replace_with_system_user_token
META_AD_ACCOUNT_ID=act_XXXXXXXXXXXXXXX

# Optional. Defaults to v21.0 if unset.
# META_GRAPH_VERSION=v21.0

# Optional. Discord webhook URL used by scripts/notify-discord.ts and the
# /ads-report skill when posting daily summaries.
# Get one via: Discord channel → Edit Channel → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=
