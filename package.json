{
  "name": "meta-ads-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "Local MCP server for managing a Meta Ads account from Claude Code",
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun run --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "notify": "bun run scripts/notify-discord.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "bun-types": "^1.3.14",
    "typescript": "^5"
  }
}
